
#ifndef __meta_parse__

template <> 
class prop_record_proxy<spiritsaway::rpg_example::Buff>

{
	spiritsaway::rpg_example::Buff& m_Buff_data;
	item_msg_queue m_queue;
	const property_flags m_flag;
public:

public:
	prop_record_proxy(spiritsaway::rpg_example::Buff& data, msg_queue_base& msg_queue,
		const property_record_offset& offset, const property_flags& flag, std::uint32_t data_idx)
		: m_Buff_data(data)
		, m_queue(msg_queue, offset, data_idx)
		, m_flag(flag)
	{

	}




	const spiritsaway::rpg_example::Buff& data() const
	{
		return m_Buff_data;
	}

	prop_record_proxy<decltype(m_Buff_data.m_level)> level()
	{
		property_record_offset empty_offset;
		return prop_record_proxy<decltype(m_Buff_data.m_level)>(m_Buff_data.m_level, m_queue, empty_offset.merge(spiritsaway::rpg_example::Buff::index_for_level), m_flag.merge(property_flags{ spiritsaway::rpg_example::Buff::flag_for_level}));
	}
	prop_record_proxy<decltype(m_Buff_data.m_expire_ts)> expire_ts()
	{
		property_record_offset empty_offset;
		return prop_record_proxy<decltype(m_Buff_data.m_expire_ts)>(m_Buff_data.m_expire_ts, m_queue, empty_offset.merge(spiritsaway::rpg_example::Buff::index_for_expire_ts), m_flag.merge(property_flags{ spiritsaway::rpg_example::Buff::flag_for_expire_ts}));
	}


	void update_fields(const json& other_json)
	{
		spiritsaway::rpg_example::Buff new_Buff_data;
		if(!serialize::decode(other_json, new_Buff_data))
		{
			return;
		}
		std::vector<std::uint8_t> related_field_indexes;
		related_field_indexes.reserve(8);
		m_Buff_data.update_fields(new_Buff_data, other_json, related_field_indexes);
		json::array_t temp_encode_array(2);
		temp_encode_array[0] = related_field_indexes;
		property_record_offset empty_offset;
		for (auto one_need_flag : m_queue.m_need_flags)
		{
			if (one_need_flag.include_by(m_flag))
			{
				temp_encode_array[1] = new_Buff_data.encode_with_flag(one_need_flag, m_queue.m_encode_ignore_default, m_queue.m_encode_with_array);

				m_queue.add_for_flag(empty_offset.merge(spiritsaway::rpg_example::Buff::index_end_for_Buff), property_cmd::update_fields, one_need_flag, m_flag, json(temp_encode_array));
			}
		}
	}

	bool replay(spiritsaway::property::property_replay_offset offset, spiritsaway::property::property_cmd cmd, const json& data)
	{
		using std::swap;
		auto split_result = offset.split();
		auto field_index = split_result.second;
		auto remain_offset = split_result.first;
		switch(field_index)
		{
			case spiritsaway::rpg_example::Buff::index_for_level:
			{
				auto temp_proxy = level();
				return temp_proxy.replay(remain_offset, cmd, data);
			}
			case spiritsaway::rpg_example::Buff::index_for_expire_ts:
			{
				auto temp_proxy = expire_ts();
				return temp_proxy.replay(remain_offset, cmd, data);
			}
			case spiritsaway::rpg_example::Buff::index_end_for_Buff:
			{
				if(cmd == spiritsaway::property::property_cmd::update_fields)
				{
					update_fields(data);
					return true;
				}
				else
				{
					return false;
				}
			}
			default:
				return false;

		}
	}
};
#endif